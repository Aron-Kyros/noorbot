# Copy this to .env for local dev, or set these in Railway's Variables tab.

GROQ_API_KEY=your_groq_api_key_here
SUNNAH_API_KEY=your_sunnah_api_key_here

# Where Baileys stores WhatsApp login session files.
# On Railway, mount a Volume and point this at its mount path (e.g. /data/auth_info)
# so the session survives redeploys/restarts.
AUTH_DIR=./auth_info

BOT_PREFIX=!
PORT=3000